# -----------------------------------------------------------------------------
# n8n-hubspot-multi-touch-utm-session-stitcher
# Copy to .env (never commit it) and replace every REPLACE_WITH_ placeholder.
# Standalone engine: node --env-file=.env src/index.js --serve
# n8n: set the non-secret flags as n8n environment variables; tokens live in
# n8n credentials, not here.
# -----------------------------------------------------------------------------

# --- Safety gates (fail-safe defaults) ---------------------------------------
# Only the literal string "false" turns a safety flag off.
DRY_RUN=true
SANDBOX_MODE=true
# Third gate: required only when DRY_RUN=false AND SANDBOX_MODE=false.
ALLOW_PRODUCTION_WRITES=false

# --- HubSpot -------------------------------------------------------------------
# SANDBOX_MODE=true reads only the sandbox token. The production token is never
# read while sandbox mode is on.
HUBSPOT_SANDBOX_PRIVATE_APP_TOKEN=REPLACE_WITH_HUBSPOT_SANDBOX_PRIVATE_APP_TOKEN
HUBSPOT_PRIVATE_APP_TOKEN=REPLACE_WITH_HUBSPOT_PRIVATE_APP_TOKEN
# Optional: pin writes to one sandbox portal ID (numeric).
HUBSPOT_SANDBOX_PORTAL_ID=REPLACE_WITH_HUBSPOT_SANDBOX_PORTAL_ID
HUBSPOT_BASE_URL=https://api.hubapi.com
# Read-only contact lookups during dry runs (set false to skip HubSpot entirely).
LOOKUP_IN_DRY_RUN=true

# --- Attribution rules -----------------------------------------------------------
MAX_TOUCHPOINTS=25
# HubSpot multi-line text properties hold 65,536 characters; I keep headroom.
MAX_HISTORY_CHARS=60000
ATTRIBUTION_WINDOW_DAYS=30
PROTECT_LAST_TOUCH_FROM_DIRECT=true
# preserve = leave an unparseable history value untouched; reset = start a new array.
HISTORY_CORRUPT_STRATEGY=preserve
# Comma-separated hosts treated as internal navigation, e.g. app and docs subdomains.
INTERNAL_HOSTS=

# --- Standalone webhook server -------------------------------------------------
WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
REQUIRE_WEBHOOK_SIGNATURE=true
HOST=127.0.0.1
PORT=8787
